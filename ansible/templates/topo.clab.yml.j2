# GENERATED by ansible/deploy.yml from ansible/group_vars/all.yml. Edit the counts there, not here.
# Port plan on every leaf: eth1..eth{{ spines }} spines, then {{ route_servers }} route servers, then {{ servers }} GPU servers.
{% set S = spines %}{% set R = route_servers %}
name: {{ lab }}

topology:
  defaults:
    binds:
      - shell/bashrc:/root/.bashrc:ro

  kinds:
    sonic-vs:
      image: {{ sonic_image }}
    linux:
      image: {{ server_image }}
      cmd: sleep infinity

  nodes:
{% for n in range(1, spines + 1) %}
    spine{{ n }}: {kind: sonic-vs}
{% endfor %}
{% for l in range(1, leaves + 1) %}
    leaf{{ l }}: {kind: sonic-vs}
{% endfor %}
{% for r in range(1, route_servers + 1) %}
    rr{{ r }}:
      kind: linux
      image: {{ frr_image }}
      cmd: /usr/lib/frr/docker-start
      binds: [ansible/files/daemons:/etc/frr/daemons]
{% endfor %}
{% for s in range(1, servers + 1) %}
    srv{{ s }}: {kind: linux}
{% endfor %}

  links:
{% for l in range(1, leaves + 1) %}
{% for n in range(1, S + 1) %}
    - endpoints: ["leaf{{ l }}:eth{{ n }}", "spine{{ n }}:eth{{ l }}"]
{% endfor %}
{% for r in range(1, R + 1) %}
    - endpoints: ["leaf{{ l }}:eth{{ S + r }}", "rr{{ r }}:eth{{ l }}"]
{% endfor %}
{% for s in range(1, servers + 1) %}
    - endpoints: ["leaf{{ l }}:eth{{ S + R + s }}", "srv{{ s }}:eth{{ l }}"]
{% endfor %}
{% endfor %}
